{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-memory/schemas/fact-record-v1.json",
  "title": "FactRecord",
  "type": "object",
  "required": ["schema_version", "memory_id", "project_id", "scope", "kind", "subject", "predicate", "value", "status", "confidence", "valid_from", "recorded_at", "source"],
  "properties": {
    "schema_version": { "const": 1 },
    "memory_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "scope": { "enum": ["global", "project", "agent-private", "session"] },
    "kind": { "enum": ["architecture_decision", "lesson", "fact", "episode", "convention", "incident", "task", "note"] },
    "subject": { "type": "string", "minLength": 1, "maxLength": 512 },
    "predicate": { "type": "string", "minLength": 1, "maxLength": 128 },
    "value": {},
    "status": { "enum": ["proposed", "verified", "disputed", "superseded", "archived"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_kind", "source_ref"],
      "properties": {
        "source_kind": { "enum": ["document", "session", "episode", "user", "config", "test"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "commit_sha": { "type": ["string", "null"] },
        "content_hash": { "type": ["string", "null"] }
      }
    }
  }
}
