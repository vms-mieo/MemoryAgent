{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-memory/schemas/extraction-candidate-v1.json",
  "title": "ExtractionCandidate",
  "type": "object",
  "required": ["schema_version", "candidate_memories"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_memories": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["kind", "statement", "confidence", "epistemic_status", "sources"],
        "properties": {
          "kind": { "type": "string" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "epistemic_status": { "enum": ["confirmed", "observed", "hypothesis", "rejected"] },
          "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "entities": { "type": "array", "items": { "type": "string" } },
          "recommended_action": { "enum": ["review", "accept", "reject", "defer"] }
        }
      }
    }
  }
}
